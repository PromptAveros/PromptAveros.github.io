# Frontend production URL. Use the full project Pages URL when deploying under /<repository>.
NEXT_PUBLIC_SITE_URL=https://promptaveros.github.io
# Set to /<repository> for GitHub project Pages; use ROOT for a custom domain or user site.
NEXT_PUBLIC_BASE_PATH=ROOT
# Public API origin, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# Backend-only secrets. Never use NEXT_PUBLIC_ with these.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DIRECT_URL=postgresql://user:password@host/database?sslmode=require
PUBLIC_ORIGIN=https://promptaveros.github.io
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2$210000$replace-with-hex-salt$replace-with-hex-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
GITHUB_TOKEN=github_pat_replace-with-restricted-token
GITHUB_REPOSITORY=owner/repository
GITHUB_WORKFLOW_ID=deploy-pages.yml
GITHUB_REF=main
