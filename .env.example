# Frontend production URL and GitHub Pages path.
NEXT_PUBLIC_SITE_URL=https://promptaveros.github.io
NEXT_PUBLIC_BASE_PATH=ROOT
# Public API origin, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# Backend-only Supabase configuration. Never use NEXT_PUBLIC_ with the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUBLIC_ORIGIN=https://promptaveros.github.io
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2$210000$replace-with-hex-salt$replace-with-hex-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
GITHUB_TOKEN=github_pat_replace-with-restricted-token
GITHUB_REPOSITORY=PromptAveros/PromptAveros.github.io
GITHUB_WORKFLOW_ID=deploy-pages.yml
GITHUB_REF=main
